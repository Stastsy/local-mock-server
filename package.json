{
  "name": "local-mock-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local mock server that serves dynamic HTTP responses from an OpenAPI 3.0 specification",
  "bin": {
    "mock-server": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:acceptance": "vitest run --project acceptance"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@openapi-contrib/openapi-schema-to-json-schema": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "json-schema-faker": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
